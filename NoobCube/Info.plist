<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NoobCube</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Export compliance, answered here so TestFlight stops asking on every
	     build. "Non-exempt" is the operative word: this is not a claim that the
	     app contains no encryption. It does — GANProtocol decrypts the AES-128
	     messages a GAN smart cube sends over Bluetooth, because that protocol is
	     encrypted and there is no other way to read it.

	     It is declared exempt because the app implements no cryptography of its
	     own: it calls CommonCrypto, which is part of iOS, and does so only to
	     read a device protocol. Nothing is encrypted for transmission, there is
	     no key exchange, and no data of the child's is protected or sent
	     anywhere by it. If that reading is ever judged wrong, this key is the
	     one to change. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>NoobCube uses the camera to look at your Rubik’s cube and work out what colour each sticker is.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>NoobCube connects to your smart cube over Bluetooth so it can follow along as you turn it.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>NoobCube connects to your smart cube over Bluetooth so it can follow along as you turn it.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>Baloo2.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
